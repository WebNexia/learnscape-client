rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isGroupChat(data) {
      return data.keys().hasAll(['chatType']) && data.chatType == 'group';
    }

    function chatAdminIds(data) {
      return data.keys().hasAll(['adminIds']) && data.adminIds is list && data.adminIds.size() > 0
        ? data.adminIds
        : (
            data.keys().hasAll(['createdBy']) && data.createdBy is string && data.createdBy.size() > 0
              ? [data.createdBy]
              : []
          );
    }

    function nextAdminIds() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminIds'])
        ? request.resource.data.adminIds
        : chatAdminIds(resource.data);
    }

    function adminListChangeAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminIds'])
        || (
          request.auth.uid in chatAdminIds(resource.data) &&
          request.resource.data.adminIds is list &&
          request.resource.data.adminIds.size() > 0
        );
    }

    function groupAdminsRemain() {
      return !isGroupChat(resource.data)
        || (
          nextAdminIds() is list &&
          nextAdminIds().size() > 0 &&
          request.resource.data.participants.hasAny(nextAdminIds())
        );
    }

    // 🔹 Chats: Only participants can read/write
    match /chats/{chatId} {
      allow read: if request.auth != null && 
                  (request.auth.uid in resource.data.participants || 
                   request.auth.uid in resource.data.removedParticipants);
      
      allow create: if request.auth != null &&
                    request.auth.uid in request.resource.data.participants &&
                    (
                      !isGroupChat(request.resource.data) ||
                      (
                        request.resource.data.adminIds is list &&
                        request.auth.uid in request.resource.data.adminIds &&
                        request.resource.data.participants.hasAny(request.resource.data.adminIds)
                      )
                    );
      
      allow update: if request.auth != null && 
                    (request.auth.uid in resource.data.participants || 
                     request.auth.uid in resource.data.removedParticipants) &&
                    adminListChangeAllowed() &&
                    groupAdminsRemain();
      
      allow delete: if request.auth != null && 
                    (request.auth.uid in resource.data.participants || 
                     request.auth.uid in resource.data.removedParticipants);
    }

    // 🔹 Messages: Only chat participants can read/write
    match /chats/{chatId}/messages/{messageId} {
      allow read: if request.auth != null && 
                  (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
                   request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.removedParticipants);
      
      allow create: if request.auth != null && 
                    request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                    request.auth.uid == request.resource.data.senderId;
      
      allow update: if request.auth != null && 
                    (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
                     request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.removedParticipants);
      
      allow delete: if request.auth != null && 
                    (request.auth.uid == resource.data.senderId || 
                     request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
                     request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.removedParticipants);
    }

    // 🔹 User Blocks: Allow reading all userBlocks for blocking detection
    // Users can read all userBlocks documents to detect if they are blocked
    // Users can only write to their own userBlocks document
    match /userBlocks/{userId} {
      allow read: if request.auth != null; // Allow reading all userBlocks for blocking detection
      allow write: if request.auth != null && request.auth.uid == userId; // Only write to own blocks
    }

    // 🔹 Notifications: own read/update/delete; create allowed for app notify flows
    // but limited to known shapes so arbitrary spam payloads are rejected.
    match /notifications/{userId}/userNotifications/{notifId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['title', 'message', 'isRead', 'timestamp', 'type'])
        && request.resource.data.isRead == false
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.type in [
          'QuizSubmission',
          'MessageReceived',
          'ReportTopic',
          'ReportMessage',
          'ReplyToCommunityMessage',
          'ReplyToCommunityTopic',
          'NewCommunityTopic',
          'MentionUser',
          'CommunityNotification',
          'AddToEvent',
          'PublicEvent',
          'CourseInstructorAssignment'
        ];
    }

    // 🔹 Users: Read all, write only own
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // 🔹 Default rule - deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
